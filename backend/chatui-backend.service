[Unit]
Description=chatui backend - FastAPI layer behind the chat web UI, talks to vllm-router
After=network-online.target vllm-router.service
Wants=network-online.target vllm-router.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hrm/local/chatui/backend
# .env (vllm-router admin key, JWT secret) is read by python-dotenv relative to WorkingDirectory.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/hrm/local/chatui/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:/home/ubuntu/hrm/local/chatui/backend/logs/backend.log
StandardError=append:/home/ubuntu/hrm/local/chatui/backend/logs/backend.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/hrm/local/chatui/backend

[Install]
WantedBy=multi-user.target
